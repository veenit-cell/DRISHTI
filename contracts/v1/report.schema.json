{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ev2.local/contracts/v1/report.schema.json",
  "title": "EV2 Report Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "client_record_id", "source", "report_type", "facts", "privacy_class"],
  "properties": {
    "contract_version": { "const": 1 },
    "client_record_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "observed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "received_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "source_class"],
      "properties": {
        "channel": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_class": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "location": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometry"],
          "properties": {
            "geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "Point" },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "uncertainty_m": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
            "place_text": { "oneOf": [{ "type": "string", "maxLength": 256 }, { "type": "null" }] }
          }
        }
      ]
    },
    "report_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "facts": { "type": "object" },
    "privacy_class": { "enum": ["restricted_operational", "internal"] }
  }
}
